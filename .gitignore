/target

# cargo-fuzz build artifacts and runtime output (fuzz/ itself is committed)
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/Cargo.lock

# Local dev database for sqlx compile-time query checking + its env file.
# Builds use the committed .sqlx/ offline cache (SQLX_OFFLINE) instead.
/.env
/dev.db
/dev.db-wal
/dev.db-shm

# Runtime database created by running the binary (default --db-path, SPEC §10).
/sagittarius.db
/sagittarius.db-wal
/sagittarius.db-shm
